# Never commit real credentials.
ROBLOX_API_KEY=
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=

# Optional asset-generation providers (configure only providers you choose).
APOLO_ASSET_PROVIDER=
APOLO_ASSET_PROVIDER_API_KEY=

# Local workspace for generated project files.
APOLO_WORKSPACE=./workspace
APOLO_DEFAULT_INTEGRATION=studio_compat

# Direct publishing through MCP is disabled unless explicitly opted in.
APOLO_ALLOW_DIRECT_PUBLISH=false

# Cloud Luau execution is powerful and disabled by default.
APOLO_ALLOW_LUAU_EXECUTION=false

# Saving generated scenes is destructive and remains disabled by default.
APOLO_ALLOW_PLACE_SAVE=false
